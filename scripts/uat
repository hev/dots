#!/usr/bin/env node
// The repo's own acceptance checks, for Mini (see AGENTS.md). Run in a fresh
// checkout at the candidate, with UAT_COMMIT (40-char sha) and UAT_DIR (a
// writable evidence dir) set. Prints one JSON line:
//   {"passed":bool,"version":"<short sha>","checks":[{"name","passed","detail"}]}
//
//   scripts/uat preview            install, test, start the fixture dot on a free
//                                  loopback port (no live writes), check it over HTTP
//                                  and in headless Chromium, stop it
//   scripts/uat live <base-url>    read-only: /api/info reports UAT_COMMIT, and a smoke check

import { spawn, spawnSync } from "node:child_process";
import { mkdirSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const commit = process.env.UAT_COMMIT ?? "";
const dir = process.env.UAT_DIR ?? join(root, ".uat");
const checks = [];
const check = async (name, fn) => {
  try {
    const detail = await fn();
    checks.push({ name, passed: true, detail: String(detail ?? "ok").slice(0, 300) });
    return true;
  } catch (e) {
    checks.push({ name, passed: false, detail: String(e?.message ?? e).slice(0, 600) });
    return false;
  }
};
const finish = () => {
  const passed = checks.length > 0 && checks.every((c) => c.passed);
  console.log(JSON.stringify({ passed, version: commit.slice(0, 7), checks }));
  process.exit(passed ? 0 : 1);
};
const run = (cmd, args) => {
  const r = spawnSync(cmd, args, { cwd: root, encoding: "utf8" });
  mkdirSync(dir, { recursive: true });
  writeFileSync(join(dir, `${cmd}-${args.join("-")}.log`.replace(/[^\w.-]/g, "_")), (r.stdout ?? "") + (r.stderr ?? ""));
  if (r.status !== 0) throw new Error(`${cmd} ${args.join(" ")} exited ${r.status}: ${((r.stderr || r.stdout) ?? "").slice(-400)}`);
  return r.stdout;
};
const get = async (url, init) => {
  const r = await fetch(url, init);
  if (!r.ok) throw new Error(`${url} answered ${r.status}`);
  return r;
};
const expect = (cond, msg) => {
  if (!cond) throw new Error(msg);
};

async function playwright() {
  const dirs = [root, ...(process.env.NODE_PATH ?? "").split(":").filter(Boolean).map((d) => join(d, "..")), process.cwd()];
  const g = spawnSync("npm", ["root", "-g"], { encoding: "utf8" });
  if (g.status === 0) dirs.push(join(g.stdout.trim(), ".."));
  for (const d of dirs) {
    try {
      return createRequire(join(d, "x.js"))("playwright");
    } catch {}
  }
  throw new Error("playwright isn't installed here");
}

async function preview() {
  expect(/^[0-9a-f]{40}$/.test(commit), "UAT_COMMIT must be a 40-char sha");
  if (!(await check("install", () => (run("npm", ["ci"]), "npm ci")))) return;
  await check("tests", () => (run("npm", ["test"]), "npm test"));
  await check("typecheck", () => (run("npm", ["run", "check"]), "npm run check"));

  const child = spawn(process.execPath, [join(root, "scripts/uat-server.ts")], { cwd: root, env: { ...process.env, UAT_COMMIT: commit, PORT: "0" }, stdio: ["ignore", "pipe", "inherit"] });
  try {
    const base = await new Promise((ok, no) => {
      child.on("exit", (c) => no(new Error(`fixture server exited ${c}`)));
      setTimeout(() => no(new Error("fixture server didn't start in 20s")), 20000);
      child.stdout.on("data", (b) => {
        const m = /listening (\d+)/.exec(String(b));
        if (m) ok(`http://127.0.0.1:${m[1]}`);
      });
    });
    await check("server starts", () => base);
    await check("/api/info reports the candidate", async () => {
      const i = await (await get(base + "/api/info")).json();
      expect(i.version?.commit === commit, `reports ${i.version?.commit}`);
      return i.version.short;
    });
    await check("screen serves with the version tag", async () => {
      const html = await (await get(base + "/")).text();
      expect(html.includes(`data-sha="${commit.slice(0, 7)}"`), "no version tag in the page");
    });
    await check("browser: silent desktop/mobile text chat, picker, errors and reload", async () => {
      const { chromium } = await playwright();
      const browser = await chromium.launch();
      try {
        for (const viewport of [{ width: 1440, height: 900 }, { width: 390, height: 800 }]) {
          const p = await browser.newPage({ viewport });
          await p.addInitScript(() => {
            window.__audio = { contexts: 0, media: 0, sockets: 0, playback: 0 };
            for (const key of ["AudioContext", "webkitAudioContext", "Audio", "WebSocket"]) {
              if (!window[key]) continue;
              const original = window[key];
              window[key] = new Proxy(original, { construct(target, args) {
                window.__audio[key === "WebSocket" ? "sockets" : key === "Audio" ? "playback" : "contexts"]++;
                return Reflect.construct(target, args);
              } });
            }
            if (navigator.mediaDevices) navigator.mediaDevices.getUserMedia = async () => {
              window.__audio.media++; throw new Error("unexpected microphone");
            };
            HTMLMediaElement.prototype.play = async () => { window.__audio.playback++; };
          });
          const requests = [];
          p.on("request", r => requests.push(r.url()));
          await p.goto(base + "/");
          await p.waitForFunction(() => document.querySelector("#model")?.options.length === 3);
          expect(await p.isVisible("#type") && await p.isVisible("#send"), "composer and send visible");
          expect(await p.getAttribute("#type", "aria-label") === "Message", "composer has accessible name");
          await p.fill("#type", "line one");
          await p.press("#type", "Shift+Enter");
          await p.type("#type", "line two");
          expect((await p.inputValue("#type")).includes("\n"), "Shift+Enter keeps newline");
          await p.selectOption("#model", "alternate");
          const turn = p.waitForRequest(r => r.url().endsWith("/chat"));
          await p.click("#send");
          expect((await turn).postDataJSON().model === "alternate", "selected allowlisted ID sent");
          await p.waitForFunction(() => document.querySelector("#conversation")?.textContent.includes("You said: line one"));
          expect(await p.isVisible("#conversation .d"), "reply visible in conversation");
          expect(await p.evaluate(() => document.documentElement.scrollWidth <= innerWidth), "no horizontal overflow");
          await p.route("**/api/chat", r => r.fulfill({ status: 503, body: "unavailable" }));
          await p.fill("#type", "retry me");
          await p.click("#send");
          await p.waitForFunction(() => document.querySelector("#type").value === "retry me" && !document.querySelector("#send").disabled);
          expect(await p.evaluate(() => Object.values(window.__audio).every(n => n === 0)), "zero audio/media/microphone/WebSocket before opt-in");
          expect(!requests.some(u => /\/(token|cue)(\?|$)/.test(u)), "no voice token or cue request");
          mkdirSync(dir, { recursive: true });
          await p.screenshot({ path: join(dir, "chat-" + viewport.width + ".png") });
          await p.reload();
          expect(await p.evaluate(() => Object.values(window.__audio).every(n => n === 0)), "reload stays silent");
          await p.close();
        }
      } finally { await browser.close(); }
      return "desktop/mobile text reply, multiline input, model selection, recoverable failure, reload: zero audio/media/mic/WS";
    });
    await check("browser: phone voice mode is the centered orb; Chat, the orb and a typed turn go back to chat with voice turns kept; thinking bubble", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        const p = await b.newPage({ viewport: { width: 390, height: 800 } });
        const errors = [];
        p.on("pageerror", (e) => errors.push(String(e)));
        // A stand-in Live socket (the fixture has no voice): it opens, answers setup, and the test drives its turns.
        await p.addInitScript(() => {
          window.__socks = [];
          window.WebSocket = class {
            constructor(url) { this.url = url; this.sent = []; this.readyState = 0; window.__socks.push(this); setTimeout(() => { this.readyState = 1; this.onopen?.(); }, 10); }
            send(s) { this.sent.push(s); if (s.includes('"setup"')) setTimeout(() => this.push({ setupComplete: {} }), 10); }
            push(m) { this.onmessage?.({ data: JSON.stringify(m) }); }
            close(code) { this.readyState = 3; setTimeout(() => this.onclose?.({ code }), 10); }
          };
          if (navigator.mediaDevices) navigator.mediaDevices.getUserMedia = async () => { throw new Error("no mic in UAT"); };
        });
        await p.route("**/api/token*", (r) => r.fulfill({ contentType: "application/json", body: JSON.stringify({ token: "uat", model: "uat-live" }) }));
        // /chat answers only when the test lets it, so the thinking bubble can be seen in flight
        let hold = null;
        await p.route("**/api/chat", async (r) => { if (hold) await hold.promise; return r.fallback(); });
        const gate = () => { let open; const promise = new Promise((ok) => (open = ok)); hold = { promise, open }; return hold; };
        await p.goto(base + "/");
        // Thinking bubble: in the conversation while /chat is out, gone with the reply
        let g = gate();
        await p.fill("#type", "typed before voice");
        await p.press("#type", "Enter");
        await p.waitForSelector("#conversation .m.d.thinking");
        expect((await p.textContent("#conversation .thinking")).includes("Thinking…"), "bubble says Thinking…");
        expect(await p.evaluate(() => { const c = document.querySelector("#conversation"), t = c.querySelector(".thinking").getBoundingClientRect(), r = c.getBoundingClientRect(); return t.bottom <= r.bottom + 1 && t.top >= r.top - 1; }), "bubble scrolled into view");
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "thinking-390.png") });
        g.open(); hold = null;
        await p.waitForFunction(() => document.querySelector("#conversation").textContent.includes("You said: typed before voice"));
        expect(!(await p.isVisible("#conversation .thinking")), "bubble gone with the reply");
        // ... and gone on an error, with the draft kept
        g = gate();
        await p.route("**/api/chat", async (r) => { if (hold) await hold.promise; return r.fulfill({ status: 503, body: "unavailable" }); });
        await p.fill("#type", "this one fails");
        await p.press("#type", "Enter");
        await p.waitForSelector("#conversation .thinking");
        g.open(); hold = null;
        await p.waitForFunction(() => !document.querySelector("#conversation .thinking") && document.querySelector("#type").value === "this one fails");
        await p.unroute("**/api/chat");
        await p.fill("#type", "");
        // Voice mode: the 150px orb in the middle, the chat hidden, what was heard and said under it
        expect(!(await p.evaluate(() => document.body.classList.contains("voice-mode"))), "chat by default");
        await p.click("#dot");
        await p.waitForFunction(() => document.body.classList.contains("voice-mode") && document.querySelector("#dot").classList.contains("on"));
        await p.evaluate(() => { const s = window.__socks.at(-1); s.push({ serverContent: { inputTranscription: { text: "what is on today" } } }); s.push({ serverContent: { outputTranscription: { text: "Two meetings and a walk." }, turnComplete: true } }); });
        const orb = await p.evaluate(() => { const d = document.querySelector("#dot").getBoundingClientRect(), m = document.querySelector("main").getBoundingClientRect(), c = document.querySelector("#core").getBoundingClientRect(); return { w: d.width, h: d.height, off: Math.abs(d.left + d.width / 2 - (m.left + m.width / 2)), core: c.width, label: getComputedStyle(document.querySelector(".voiceLabel")).display }; });
        expect(Math.abs(orb.w - 150) <= 2 && Math.abs(orb.h - 150) <= 2, "orb is 150px: " + JSON.stringify(orb));
        expect(orb.off <= 2, "orb is centered: " + JSON.stringify(orb));
        expect(Math.abs(orb.core - 90) <= 2 && orb.label === "none", "glowing core, no label: " + JSON.stringify(orb));
        expect(!(await p.isVisible("#conversation")), "conversation hidden in voice mode");
        expect(await p.isVisible("#you") && await p.isVisible("#say"), "#you and #say visible under the orb");
        expect((await p.textContent("#say")) === "Two meetings and a walk.", "#say shows the spoken reply");
        expect(await p.isVisible("#toChat"), "a Chat button back");
        const sent = await p.evaluate(() => window.__socks.at(-1).sent.join("\n"));
        expect(sent.includes("typed before voice") && sent.includes("You said: typed before voice"), "typed turns handed to Live as context");
        expect(await p.evaluate(() => document.documentElement.scrollWidth <= innerWidth), "no horizontal overflow in voice mode");
        await p.screenshot({ path: join(dir, "voice-mode-390.png") });
        // Chat: back to the conversation, voice turns kept, a late close changes nothing
        await p.click("#toChat");
        await p.waitForTimeout(60);
        expect(!(await p.evaluate(() => document.body.classList.contains("voice-mode"))), "Chat leaves voice mode");
        expect(await p.evaluate(() => window.__socks.at(-1).readyState === 3), "socket closed");
        expect(await p.isVisible("#conversation") && !(await p.isVisible("#you")), "conversation back");
        const thread = await p.textContent("#conversation");
        expect(thread.includes("what is on today") && thread.includes("Two meetings and a walk.") && thread.includes("typed before voice"), "voice and typed turns all in the thread");
        await p.screenshot({ path: join(dir, "voice-back-to-chat-390.png") });
        // The orb: tap in, tap out
        await p.click("#dot");
        await p.waitForFunction(() => document.querySelector("#dot").classList.contains("on"));
        await p.click("#dot");
        await p.waitForTimeout(60);
        expect(!(await p.evaluate(() => document.body.classList.contains("voice-mode"))), "the orb stops voice");
        // A typed turn from voice mode: back to chat with its reply
        await p.click("#dot");
        await p.waitForFunction(() => document.body.classList.contains("voice-mode"));
        await p.fill("#type", "typed from voice");
        await p.press("#type", "Enter");
        await p.waitForFunction(() => document.querySelector("#conversation").textContent.includes("You said: typed from voice"));
        await p.waitForTimeout(60);
        expect(!(await p.evaluate(() => document.body.classList.contains("voice-mode"))), "a typed turn leaves voice mode");
        expect(await p.isVisible("#conversation"), "conversation visible after typing");
        expect(!errors.length, "page errors: " + errors.join("; "));
      } finally {
        await b.close();
      }
      return "orb 150px centered, chat hidden, typed context to Live; Chat/orb/typing back to chat with voice turns; bubble on reply and error";
    });
    await check("browser: apps open, back closes, session survives", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        const p = await b.newPage({ viewport: { width: 390, height: 800 } });
        const errors = [];
        p.on("pageerror", (e) => errors.push(String(e)));
        await p.goto(base + "/");
        expect((await p.textContent("#ver")).startsWith(commit.slice(0, 7)), "tag shows the short sha");
        await p.fill("#type", "hello there");
        await p.press("#type", "Enter");
        await p.waitForFunction(() => document.querySelector("#say")?.textContent?.includes("You said: hello there"));
        const before = await p.evaluate(() => document.querySelector("#list").children.length);
        await p.fill("#type", "open notes");
        await p.press("#type", "Enter");
        await p.waitForSelector("#apps .app-view [id=note]");
        expect(await p.isVisible("#pill"), "pill is visible with an app open");
        expect((await p.evaluate(() => history.length)) >= 2, "open pushed a history entry");
        await p.goBack();
        await p.waitForFunction(() => !document.querySelector("#apps .app-view"));
        expect(!(await p.isVisible("#pill")), "pill hides on close");
        expect((await p.evaluate(() => document.querySelector("#list").children.length)) > before, "transcript survived");
        expect((await p.textContent("#list")).includes("hello there"), "earlier turn still in the transcript");
        await p.evaluate(() => window.dotApps.open("notes"));
        await p.click("#pill");
        await p.waitForFunction(() => window.dotApps.current() === null);
        expect(await p.evaluate(() => window.__appClosed >= 2), "app cleanup ran on each close");
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "screen.png") });
        expect(!errors.length, "page errors: " + errors.join("; "));
      } finally {
        await b.close();
      }
      return "ok";
    });
    await check("browser: header fits one row at 360px; log from info; build in info; lock in private mode", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        mkdirSync(dir, { recursive: true });
        for (const colorScheme of ["light", "dark"]) {
          const p = await b.newPage({ viewport: { width: 360, height: 740 }, colorScheme });
          const errors = [];
          p.on("pageerror", (e) => errors.push(String(e)));
          await p.goto(base + "/");
          const h = await p.evaluate(() => {
            const hd = document.querySelector("header");
            const box = (s) => { const e = document.querySelector(s); if (!e || e.hidden) return null; const r = e.getBoundingClientRect(); return { x: r.left, y: r.top, w: r.width, h: r.height, right: r.right }; };
            const btns = [...hd.querySelectorAll("button")].filter((e) => !e.hidden).map((e) => { const r = e.getBoundingClientRect(); return { id: e.id, w: r.width, h: r.height, top: r.top, right: r.right }; });
            return { over: hd.scrollWidth > hd.clientWidth, width: hd.clientWidth, right: Math.max(...btns.map((x) => x.right)), btns, threads: box("#threadsBtn"), wm: box(".wm"), mode: box("#mode"), info: box("#infoBtn") };
          });
          expect(!h.over && h.right <= h.width, `header overflows: ${JSON.stringify(h)}`);
          expect(new Set(h.btns.map((x) => Math.round(x.top))).size === 1, "header buttons on one row");
          expect(h.btns.every((x) => x.w >= 40 && x.h >= 40), `tap targets under 40px: ${JSON.stringify(h.btns)}`);
          expect(h.threads.right <= h.wm.x && h.wm.right <= h.mode.x && h.mode.right <= h.info.x, "order is ☰, wordmark, mode, i");
          expect(!(await p.isVisible("#ver")) && !(await p.isVisible("#logBtn")), "build and log aren't on the screen");
          // private mode: a shut lock, named for screen readers
          if ((await p.getAttribute("#mode", "aria-label")) !== "private mode") await p.click("#mode");
          expect((await p.getAttribute("#mode", "aria-label")) === "private mode", "mode switches to private");
          expect(await p.isVisible("#mode svg"), "the lock is an svg");
          await p.screenshot({ path: join(dir, `header-private-${colorScheme}.png`), clip: { x: 0, y: 0, width: 360, height: 80 } });
          await p.click("#mode");
          expect((await p.getAttribute("#mode", "aria-label")) === "demo mode", "and back to demo");
          await p.screenshot({ path: join(dir, `header-demo-${colorScheme}.png`), clip: { x: 0, y: 0, width: 360, height: 80 } });
          // info: the build, tap to copy; the log opens from it and closes back into it
          await p.click("#infoBtn");
          await p.waitForSelector("#info.on #ver");
          expect((await p.textContent("#ver")).startsWith(commit.slice(0, 7)), "build shows the short sha");
          await p.screenshot({ path: join(dir, `info-${colorScheme}.png`) });
          await p.click("#logBtn");
          await p.waitForSelector("#log.on");
          await p.keyboard.press("Escape");
          await p.waitForFunction(() => !document.querySelector("#log").classList.contains("on") && document.querySelector("#info").classList.contains("on"));
          await p.click("#logBtn");
          await p.waitForSelector("#log.on");
          await p.goBack();
          await p.waitForFunction(() => !document.querySelector("#log").classList.contains("on") && document.querySelector("#info").classList.contains("on"));
          await p.goBack();
          await p.waitForFunction(() => !document.querySelector("#info").classList.contains("on"));
          expect(!errors.length, "page errors: " + errors.join("; "));
          await p.close();
        }
      } finally {
        await b.close();
      }
      return "ok";
    });
    await check("browser: threads drawer lists, resumes, starts fresh; back and Escape close it", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        const p = await b.newPage({ viewport: { width: 360, height: 740 } });
        const errors = [];
        p.on("pageerror", (e) => errors.push(String(e)));
        await p.goto(base + "/");
        await p.fill("#type", "first thread line");
        await p.press("#type", "Enter");
        await p.waitForFunction(() => document.querySelector("#say")?.textContent?.includes("You said: first thread line"));
        await p.click("#threadsBtn");
        await p.waitForSelector("#threads.on #threadList .th");
        await p.goBack();
        await p.waitForFunction(() => !document.querySelector("#threads").classList.contains("on"));
        await p.click("#threadsBtn");
        await p.waitForSelector("#threads.on");
        await p.keyboard.press("Escape");
        await p.waitForFunction(() => !document.querySelector("#threads").classList.contains("on"));
        await p.click("#threadsBtn");
        await p.click("#newThread");
        await p.waitForFunction(() => !document.querySelector("#list").textContent.includes("first thread line"));
        await p.click("#threadsBtn");
        await p.click("#threadList .th >> text=first thread line");
        await p.waitForFunction(() => document.querySelector("#list").textContent.includes("first thread line"));
        expect(!(await p.isVisible("#threads")), "drawer closes on resume");
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "threads.png") });
        expect(!errors.length, "page errors: " + errors.join("; "));
      } finally {
        await b.close();
      }
      return "ok";
    });
    await check("browser: approval card on mobile: approve runs once, always stops asking, cancel doesn't run", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        const p = await b.newPage({ viewport: { width: 390, height: 800 } });
        const errors = [];
        p.on("pageerror", (e) => errors.push(String(e)));
        const posts = [];
        p.on("request", (r) => { if (r.url().includes("/api/approvals/")) posts.push(r.postDataJSON()); });
        await p.goto(base + "/");
        const card = (n) => p.locator("#conversation .approval").nth(n);
        // Approve
        await p.fill("#type", "log 1h");
        await p.press("#type", "Enter");
        await card(0).waitFor();
        expect((await card(0).locator("b").textContent()) === "Approve log time?", "card names the tool");
        expect((await card(0).locator(".sum").textContent()) === "duration: 1h", "card shows the arguments");
        for (const name of ["Approve", "Always approve", "Cancel"]) expect(await card(0).getByRole("button", { name, exact: true }).isVisible(), name + " visible");
        expect(await p.evaluate(() => document.documentElement.scrollWidth <= innerWidth), "no horizontal overflow");
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "approval-card.png") });
        await card(0).getByRole("button", { name: "Approve", exact: true }).click();
        await p.waitForFunction(() => document.querySelector("#conversation .approval .st")?.textContent === "Approved. Done.");
        expect(await card(0).getByRole("button", { name: "Approve", exact: true }).isHidden(), "buttons go once answered");
        // Cancel
        await p.fill("#type", "log 2h");
        await p.press("#type", "Enter");
        await card(1).waitFor();
        await card(1).getByRole("button", { name: "Cancel", exact: true }).click();
        await p.waitForFunction(() => document.querySelectorAll("#conversation .approval")[1]?.querySelector(".st")?.textContent.startsWith("Cancelled"));
        // Always approve, then the next call runs without a card
        await p.fill("#type", "log 3h");
        await p.press("#type", "Enter");
        await card(2).waitFor();
        await card(2).getByRole("button", { name: "Always approve", exact: true }).click();
        await p.waitForFunction(() => /without asking/.test(document.querySelectorAll("#conversation .approval")[2]?.querySelector(".st")?.textContent || ""));
        await p.fill("#type", "log 4h");
        await p.press("#type", "Enter");
        await p.waitForFunction(() => document.querySelector("#conversation")?.textContent.includes("Logged 4h."));
        expect((await p.locator("#conversation .approval").count()) === 3, "no card once it's always");
        expect(JSON.stringify(posts) === JSON.stringify([{ decision: "approve" }, { decision: "deny" }, { decision: "always" }]), "posts: " + JSON.stringify(posts));
        // The card's answer is the user's alone: an anonymous approval is refused by the server.
        const anon = await fetch(base + "/api/approvals/00000000-0000-0000-0000-000000000000", { method: "POST", headers: { "content-type": "text/plain" }, body: '{"decision":"approve"}' });
        expect(anon.status === 415, "a non-JSON post is refused: " + anon.status);
        await p.screenshot({ path: join(dir, "approval-done.png") });
        expect(!errors.length, "page errors: " + errors.join("; "));
      } finally {
        await b.close();
      }
      return "approve, cancel, always approve; the next call ran without a card";
    });
    await check("browser: configurator at /config loads, saves tools, identity, prompt and sources, and survives reload", async () => {
      const { chromium } = await playwright();
      const b = await chromium.launch();
      try {
        const p = await b.newPage({ viewport: { width: 1280, height: 860 } });
        const errors = [];
        p.on("pageerror", (e) => errors.push(String(e)));
        await p.goto(base + "/config");
        await p.waitForSelector('#toolList .tool[data-tool="log_time"]');
        expect((await p.getAttribute('.tool[data-tool="log_time"] [data-approval="always"]', "aria-pressed")) === "true", "the card's Always approve shows here");
        // Tools & approvals
        await p.click('.tool[data-tool="log_time"] [data-approval="deny"]');
        await p.uncheck('.tool[data-tool="today"] input[type=checkbox]');
        expect(await p.isEnabled("#save"), "save lights up when dirty");
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "config-tools.png") });
        // Identity & look
        await p.click("#tab-identity");
        await p.fill("#idName", "UAT Pip");
        await p.click('#iconPresets [data-src="/icon.png"]');
        await p.click('#themePresets [data-color="#336699"]');
        await p.selectOption("#idVoice", "Puck");
        await p.selectOption("#idModel", "alternate");
        // System prompt: dirty mark, diff, reset
        await p.click("#tab-prompt");
        expect((await p.inputValue("#promptText")) === "Be brief.", "default prompt loads");
        await p.fill("#promptText", "Be brief.\nSpeak like a sailor.");
        await p.waitForFunction(() => document.querySelector("#promptMark").classList.contains("dirty"));
        expect((await p.textContent("#promptDiff")).includes("+ Speak like a sailor."), "diff shows the added line");
        await p.click("#promptReset");
        expect((await p.inputValue("#promptText")) === "Be brief.", "reset to default");
        await p.fill("#promptText", "Be brief.\nSpeak like a sailor.");
        // Sources
        await p.click("#tab-sources");
        await p.click("#addSource");
        await p.fill("#sourceList .src:last-child textarea", '{"kind":"feed","name":"news","url":"https://example.com/rss"}');
        mkdirSync(dir, { recursive: true });
        await p.screenshot({ path: join(dir, "config-dirty.png") });
        const put = p.waitForResponse((r) => r.url().endsWith("/api/config") && r.request().method() === "PUT");
        await p.click("#save");
        expect((await put).status() === 200, "PUT saved");
        await p.waitForFunction(() => document.querySelector("#dirty").textContent === "all saved");
        // Reload: every edit is still there
        await p.reload();
        await p.waitForSelector('#toolList .tool[data-tool="log_time"]', { state: "attached" });
        expect(await p.isVisible("#sourceList"), "the tab you were on comes back");
        await p.click("#tab-tools");
        expect((await p.getAttribute('.tool[data-tool="log_time"] [data-approval="deny"]', "aria-pressed")) === "true", "deny kept");
        expect(!(await p.isChecked('.tool[data-tool="today"] input[type=checkbox]')), "today off kept");
        await p.click("#tab-identity");
        expect((await p.inputValue("#idName")) === "UAT Pip", "name kept");
        expect((await p.inputValue("#idIcon")) === "/icon.png", "icon kept");
        expect((await p.inputValue("#idTheme")) === "#336699", "theme kept");
        expect((await p.inputValue("#idVoice")) === "Puck", "voice kept");
        expect((await p.inputValue("#idModel")) === "alternate", "model kept");
        await p.click("#tab-prompt");
        expect((await p.inputValue("#promptText")) === "Be brief.\nSpeak like a sailor.", "prompt kept");
        expect((await p.textContent("#promptMark")).includes("edited from the default"), "marked as edited");
        await p.click("#tab-sources");
        expect((await p.inputValue("#sourceList .src textarea")).includes('"url": "https://example.com/rss"'), "source kept");
        await p.screenshot({ path: join(dir, "config-saved.png") });
        // The server refuses a bad value whole, and the page says so
        await p.click("#tab-identity");
        await p.fill("#idIcon", "javascript:alert(1)");
        await p.click("#save");
        await p.waitForFunction(() => /Not saved: icon/.test(document.querySelector("#toast").textContent));
        // Takes effect without a restart: the screen draws the new name, and the denied tool is refused
        const s = await b.newPage({ viewport: { width: 390, height: 800 } });
        await s.goto(base + "/");
        await s.waitForFunction(() => document.title === "UAT Pip");
        const i = await (await get(base + "/api/info")).json();
        expect(i.identity.name === "UAT Pip" && i.defaultModel === "alternate-fixture" && !i.tools.some((t) => t.name === "today"), "info: " + JSON.stringify(i.identity));
        expect(!errors.length, "page errors: " + errors.join("; "));
      } finally {
        await b.close();
      }
      return "tools/approvals, identity, prompt (diff, reset), sources saved and reloaded; screen took the new name";
    });
  } finally {
    child.removeAllListeners("exit");
    child.kill();
  }
}

async function live(base) {
  expect(/^[0-9a-f]{40}$/.test(commit), "UAT_COMMIT must be a 40-char sha");
  expect(base, "usage: scripts/uat live <base-url>");
  base = base.replace(/\/$/, "");
  await check("version endpoint reports the candidate", async () => {
    const i = await (await get(base + "/api/info")).json();
    expect(i.version?.commit === commit, `live reports ${i.version?.commit ?? "no version"}, wanted ${commit}`);
    return i.version.short;
  });
  await check("smoke: the screen serves", async () => {
    const html = await (await get(base + "/")).text();
    expect(html.includes("<title>") && html.includes('id="dot"'), "not the dot screen");
    // The tag shows the sha, or a dot's semver with the sha in data-sha.
    expect(html.includes(`>${commit.slice(0, 7)} · `) || html.includes(`data-sha="${commit.slice(0, 7)}"`), "screen's version tag doesn't match");
  });
}

const [mode, arg] = process.argv.slice(2);
if (mode === "preview") await preview();
else if (mode === "live") await live(arg);
else {
  console.error("usage: scripts/uat preview | scripts/uat live <base-url>");
  process.exit(2);
}
finish();
